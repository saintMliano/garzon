# ============================================
# GARZÓN DIGITAL — Variables de entorno
# Copia este archivo a .env.local y completa los valores.
# (.env.local NO se versiona.)
# ============================================

# Supabase — Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-PUBLISHABLE-KEY

# Slug del local demo enlazado desde la landing
NEXT_PUBLIC_DEMO_SLUG=el-lalo

# URL pública del sitio. De acá sale el `metadataBase` del layout, que es lo que
# vuelve absoluta la imagen de OpenGraph: sin esto, el link que se pega en
# WhatsApp llega sin miniatura. En local se puede dejar vacía (cae a localhost);
# en Vercel hay que definirla en el entorno de producción.
NEXT_PUBLIC_SITE_URL=https://garzondigital.cl

# SERVER-ONLY: service-role key (alta de locales / operaciones admin).
# NUNCA la expongas al cliente ni la subas al repo.
SUPABASE_SERVICE_ROLE_KEY=TU-SECRET-KEY

# ============================================
# Solo para tareas de mantenimiento en local (CLI de Supabase).
# No hacen falta para correr la app ni para el deploy.
# ============================================

# Personal Access Token: supabase.com/dashboard/account/tokens
# Lo usa `npm run db:push` / `db:types`. Se muestra una sola vez al crearlo.
SUPABASE_ACCESS_TOKEN=sbp_TU-TOKEN

# Contraseña de Postgres: Project Settings > Database.
# La app NO la usa (usa las API keys de arriba); solo el CLI.
# scripts/con-env.mjs la mapea a SUPABASE_DB_PASSWORD para no pasarla por
# línea de comandos, donde quedaría en el historial del shell.
DATABASE_PASSWORD=TU-CLAVE-DE-POSTGRES
